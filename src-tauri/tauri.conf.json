{
  "productName": "Dawai Pharmacy",
  "version": "0.2.0",
  "identifier": "com.dawai.pharmacy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "دوائي | إدارة الصيدلية",
        "width": 1440,
        "height": 960,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "category": "Business",
    "shortDescription": "Offline pharmacy management",
    "longDescription": "Arabic and English offline desktop pharmacy management system.",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwN0ZFRDM3RDk2RTIwNkUKUldSdUlHN1pOKzEvOEZqNXQvdG9VOWhCSEQ3bjYwMGpzZW9MclNlclkxTkRwQTVsZDc4UDNoOXoK",
      "endpoints": [
        "https://github.com/montasir199/Pharmacy-Management-/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
